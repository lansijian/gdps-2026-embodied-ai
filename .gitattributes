# Ensure shell scripts always use LF line endings (Linux robots fail on CRLF).
*.sh        text eol=lf
*.bash      text eol=lf

# Python and ROS 2 launch/config files: keep LF for cross-platform consistency.
*.py        text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.xml       text eol=lf
*.json      text eol=lf
*.md        text eol=lf

# Binary files
*.png       binary
*.jpg       binary
*.jpeg      binary
*.zip       binary
*.tar       binary
*.gz        binary
*.bag       binary
